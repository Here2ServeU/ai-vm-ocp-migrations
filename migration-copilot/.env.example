# Copy to .env and fill in what you need. Never commit .env (it is git-ignored).
# Read by chat_local.py.

# ---- AI model: anthropic or openai ----
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# ---- Lab connections (leave VCENTER_URL and OCP_API_URL empty for demo mode) ----
# vCenter, read-only account. Example: https://vcenter.example.gov
VCENTER_URL=
VCENTER_USER=svc-copilot-readonly@vsphere.local
VCENTER_PASSWORD=
# Optional: path to a PEM file with the vCenter CA certificate
VCENTER_CA_CERT=

# OpenShift. Example: https://api.cluster.example.gov:6443
OCP_API_URL=
OCP_TOKEN=
# Optional: path to a PEM file with the OpenShift API server CA certificate
OCP_CA_CERT=
MTV_NAMESPACE=openshift-mtv
MTV_SOURCE_PROVIDER=vsphere
MTV_DESTINATION_PROVIDER=host
MTV_NETWORK_MAP=
MTV_STORAGE_MAP=

# Who may approve migrations (comma-separated full names).
MIGRATION_APPROVERS="Emmanuel Naweji"
