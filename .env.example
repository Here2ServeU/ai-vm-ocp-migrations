# Copy to .env and fill in what you need. Never commit .env (it is git-ignored).
# Read by: orchestrate server start -e .env, scripts/setup.sh, chat_local.py

# ---- watsonx Orchestrate Developer Edition (needed for `orchestrate server start`) ----
# Option 1: you have a watsonx Orchestrate account (a free trial works)
WO_DEVELOPER_EDITION_SOURCE=orchestrate
WO_INSTANCE=
WO_API_KEY=
# Option 2: you have watsonx.ai + an entitlement key from My IBM instead. Comment out
# option 1 above, then uncomment these:
# WO_DEVELOPER_EDITION_SOURCE=myibm
# WO_ENTITLEMENT_KEY=
# WATSONX_APIKEY=
# WATSONX_SPACE_ID=

# ---- Lab connections (leave empty for demo mode) ----
VCENTER_URL=https://vcenter.example.gov
VCENTER_USER=svc-copilot-readonly@vsphere.local
VCENTER_PASSWORD=
OCP_API_URL=https://api.cluster.example.gov:6443
OCP_TOKEN=
MTV_NAMESPACE=openshift-mtv
MTV_SOURCE_PROVIDER=vsphere
MTV_NETWORK_MAP=
MTV_STORAGE_MAP=
# Who may approve migrations (comma-separated full names).
MIGRATION_APPROVERS="Emmanuel Naweji"

# AI model provider: watsonx (default in Orchestrate), anthropic or openai.
# Used by scripts/setup.sh --llm and chat_local.py.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
